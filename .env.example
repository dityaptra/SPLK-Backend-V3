# --------------------------------------------------------------------------
# SPLK Backend — Contoh Konfigurasi
# Salin ke .env dan sesuaikan nilainya.
# --------------------------------------------------------------------------

# Lingkungan: development | production
APP_ENV=development

# Port server
APP_PORT=8080

# Zona waktu untuk perhitungan "hari ini"
APP_TIMEZONE=Asia/Makassar

# URL koneksi PostgreSQL
# Dari host (lokal):
DATABASE_URL=postgres://splk:ganti_password_ini@localhost:5432/splk_db?sslmode=disable
# Dari Docker container:
# DATABASE_URL=postgres://splk:ganti_password_ini@host.docker.internal:5432/splk_db?sslmode=disable

# JWT — Secret wajib minimal 32 karakter
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter_ya
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Penyimpanan file
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# CORS — Dipisah koma
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Level log: debug | info | warn | error
LOG_LEVEL=info

# Seed admin (hanya untuk cmd/seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@splk.undiksha.ac.id
SEED_ADMIN_PASSWORD=Admin12345678
